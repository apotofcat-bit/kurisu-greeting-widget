<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件布局。
  只能用 RemoteViews 支持的控件：TextView / ImageView / Button / LinearLayout /
  FrameLayout / RelativeLayout / GridLayout / ListView 等。
  用 ConstraintLayout 或自定义 View 会直接崩，而且崩在桌面的进程里，日志按包名过滤看不到。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bubble"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="30dp">

    <!--
      背景是一张"对话气泡"：圆角矩形 + 右下角的小尾巴，见 drawable/widget_bubble.xml。
      底部内边距比上边大 14dp —— 正好等于气泡主体底部留出的那 14dp，
      这样文字是在"气泡主体"里居中，而不是在"含尾巴的整个高度"里居中。
    -->
    <TextView
        android:id="@+id/tv_greeting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:text="@string/widget_placeholder"
        android:textColor="@color/widget_text"
        android:textSize="20sp" />

</FrameLayout>
